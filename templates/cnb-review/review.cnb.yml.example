# OPTIONAL FEEDBACK TEMPLATE: integrate into existing consumer .cnb.yml if wanted.
# Single-maintainer dev needs no mandatory protection or per-change approval.
# Strict Git governance and its deterministic review gate are explicit opt-ins;
# see docs/cnb-review.md. Existing required checks must not be silently bypassed.
# Review image v1.22.2 is an official upstream tag observed 2026-10-26.
# Verify/pin immutable image provenance at adoption; do not assume tag immutability.
# This pipeline is designed for same-repo PRs (fork PRs require a CNB API
# current-head lookup, not a guess from origin). This is functional feedback,
# not proof of review approval; report findings and failures honestly.
"**":
  pull_request:
    - docker:
        image: python:3.12-slim
      stages:
        - name: clear-old-review-result
          script: |
            rm -f ./code_review.json
            test -n "$CNB_PULL_REQUEST_SHA"
        - name: automatic-code-review
          image: cnbcool/code-review:v1.22.2
          settings:
            output: ./code_review.json
            comment: true
            max_comments: 10
            min_confidence: medium
            exclude_categories: "style,nit"
            review_event: auto
            timeout_minutes: 20
            max_turns: 30
