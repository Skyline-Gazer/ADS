# Consumer template: install the verifier on the trusted target before use.
# Protect authoritative CI configuration; a PR must not supply its own gate.
"**":
  pull_request:
    - docker:
        image: python:3.12-bookworm
      git:
        submodules: false
      stages:
        - name: prepare-trusted-review
          script: |
            set -eu
            rm -f ./code_review.json
            test "$CNB_PULL_REQUEST_SLUG" = "$CNB_REPO_SLUG"
            git show "${CNB_PULL_REQUEST_TARGET_SHA}:scripts/check-ads-cnb-review.py" > /tmp/trusted-cnb-review.py
        - name: automatic-code-review
          image: cnbcool/code-review:v1.22.2@sha256:d0af9a2e683488e2424d42d3e0bffe478c87b37d44903d4f5b8b2288480704eb
          settings:
            output: ./code_review.json
            comment: true
            max_comments: 10
            min_confidence: medium
            exclude_categories: style,nit
            review_event: comment
            timeout_minutes: 10
            max_turns: 20
        - name: current-candidate-review-gate
          script: |
            set -eu
            git check-ref-format "refs/heads/$CNB_PULL_REQUEST_BRANCH"
            git check-ref-format "refs/heads/$CNB_BRANCH"
            live_head="$(git ls-remote origin "refs/heads/$CNB_PULL_REQUEST_BRANCH" | cut -f1)"
            live_target="$(git ls-remote origin "refs/heads/$CNB_BRANCH" | cut -f1)"
            merge="$(git rev-parse HEAD)"
            test "$merge" = "$CNB_COMMIT"
            test "$merge" = "$CNB_PULL_REQUEST_MERGE_SHA"
            git merge-base --is-ancestor "$CNB_PULL_REQUEST_SHA" "$merge"
            git merge-base --is-ancestor "$CNB_PULL_REQUEST_TARGET_SHA" "$merge"
            python3 /tmp/trusted-cnb-review.py --result ./code_review.json \
              --review-head "$CNB_PULL_REQUEST_SHA" --current-head "$live_head" \
              --review-target "$CNB_PULL_REQUEST_TARGET_SHA" --current-target "$live_target" \
              --review-merge "$CNB_PULL_REQUEST_MERGE_SHA" --current-merge "$merge"
