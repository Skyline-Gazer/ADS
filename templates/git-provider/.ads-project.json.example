{
  "schema_version": 1,
  "git": {
    "primary": "cnb",
    "development_branch": "dev",
    "production_branch": "main",
    "issue_provider": "github",
    "github_mirror": {
      "enabled": false,
      "direction": "disabled",
      "branches": [],
      "tags": "disabled"
    }
  },
  "review": {
    "auto": "host-on-demand",
    "npc": "disabled",
    "max_fix_rounds": 3
  },
  "release": {
    "approval_required": true,
    "force_push": false
  }
}
