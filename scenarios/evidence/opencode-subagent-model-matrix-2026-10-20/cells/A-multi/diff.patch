diff --git a/app/tags.py b/app/tags.py
index 542e75d..9a28292 100644
--- a/app/tags.py
+++ b/app/tags.py
@@ -1,2 +1,16 @@
 def normalize_tags(values):
-    raise NotImplementedError
+    """Strip, casefold, drop empties and dedupe tags, preserving input order."""
+    if not isinstance(values, list):
+        raise ValueError("values must be a list of strings")
+
+    normalized = []
+    seen = set()
+    for value in values:
+        if not isinstance(value, str):
+            raise ValueError("every tag must be a string")
+        tag = value.strip().casefold()
+        if not tag or tag in seen:
+            continue
+        seen.add(tag)
+        normalized.append(tag)
+    return normalized
